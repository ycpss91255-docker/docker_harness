# claude-workspace — repo-level .gitignore
#
# This workspace contains many independent sub-repos checked out side by side.
# We only track workspace-level config here:
#   - CLAUDE.md                   (workspace-level rules)
#   - .claude/settings.json       (committed hook config)
#   - .claude/hooks/              (hook scripts)
#   - .claude/commands/           (slash commands)
#   - .claude/skills/<repo-owned> (symlinks into .agents/skills/; third-party
#                                  mattpocock skills are machine-local)
#
# Everything else is ignored.

# ── Sub-repos (have their own .git, managed independently) ───────────────────
agent/*/
app/*/
env/*/
archive/*/      # archived (read-only) downstream repos kept locally for reference
template/
multi_run/
org-profile/   # local checkout of ycpss91255-docker/.github (org profile)

# Allow agent/, app/, env/ category dirs themselves to be tracked as empty
# placeholders if needed later; for now they have no tracked contents.
!.gitkeep

# ── Personal Claude state (machine-local, often contains transcripts) ────────
.claude/settings.local.json
.claude/projects/
.claude/todos/
.claude/shell-snapshots/
.claude/statsig/
.claude/ide/
# local-CI-pass markers (enforce_local_full_ci_before_pr, #176)
.claude/state/

# ── Agent skills: split canonical store (refs #210) ──────────────────────────
# Skills live canonically under .agents/skills/<name>/ with a symlink at
# .claude/skills/<name>. Repo-owned skills are tracked at BOTH ends; third-party
# (mattpocock/skills) skills are machine-local — reinstall with:
#   npx skills@latest add mattpocock/skills
# Git cannot re-include a path once its parent dir is ignored, so .agents/ and
# .claude/skills/ are ignored at the contents level and the repo-owned skills
# are negated back in explicitly (dirs trailing-slash; .claude symlinks not).
# skills-lock.json is the vendored-install state, regenerated by the skills CLI.
skills-lock.json
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/batch-mutation-pr/
!.agents/skills/gh-artifact-format/
!.agents/skills/parallel-agents/
!.agents/skills/proactive-optimization/
!.agents/skills/rebase-pr/
!.agents/skills/semver-bump/
!.agents/skills/skillification-candidates/
!.agents/skills/strategic-compact/
!.agents/skills/wait-gh-state/
!.agents/skills/wait-pr-ci/

.claude/skills/*
!.claude/skills/batch-mutation-pr
!.claude/skills/gh-artifact-format
!.claude/skills/parallel-agents
!.claude/skills/proactive-optimization
!.claude/skills/rebase-pr
!.claude/skills/semver-bump
!.claude/skills/skillification-candidates
!.claude/skills/strategic-compact
!.claude/skills/wait-gh-state
!.claude/skills/wait-pr-ci

# ── Editor / OS noise ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# ── Generated artifacts (workspace level — none expected, but defense) ───────
*.log
node_modules/
__pycache__/
*.pyc
